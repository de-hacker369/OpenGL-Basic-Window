{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OpenGL Project",
            "type": "shell",
            "command": "g++",
            "args": [
                "${workspaceFolder}/src/main.cpp",
                "-IC:/Users/HOST/OneDrive/Documents/Graphics Comp/Test-project/include",
                "-ID:/msys64/OPEN GL/ucrt64/include",
                "-LD:/msys64/OPEN GL/ucrt64/lib",
                "-lfreeglut",
                "-lopengl32",
                "-lglu32",
                "-o",
                "${workspaceFolder}/build/main.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
} 